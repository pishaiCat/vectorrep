# Creem (payments) — set in Vercel dashboard, never commit real values.
# Get them from Creem after creating the $79 one-time product.
# NOTE: the product must have license keys DISABLED — this app no longer
# uses license keys. Purchases are recorded via webhook + verify-purchase.
CREEM_API_KEY=
CREEM_PRODUCT_ID=
# Webhook signing secret for /api/webhook (Creem dashboard > Developers > Webhook).
# Used to verify the `creem-signature` header on incoming webhooks.
CREEM_WEBHOOK_SECRET=
# Where buyers land after a successful Creem checkout.
# Optional: defaults to <this deployment>/#/activate. Creem appends
# ?checkout_id=…&order_id=…&… automatically; the app auto-verifies on return.
CREEM_SUCCESS_URL=

# Firebase (purchase records) — set in Vercel dashboard, never commit real values.
# FIREBASE_SERVICE_ACCOUNT is the full service-account JSON (one line).
# Firestore collection used: `purchases` (docs keyed by Creem checkout id).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
